# Dashboard Production Environment Variables
# This file should be used when building for production
# Copy this to .env before running docker build

# Node Environment
NODE_ENV=production

# API Configuration
# IMPORTANT: Update this to your actual production backend URL before building
VITE_API_GATEWAY_URL=https://api.yourdomain.com

# Application Configuration
VITE_APP_TITLE=ABDUL - Hackathon Dashboard
VITE_APP_VERSION=1.0.0