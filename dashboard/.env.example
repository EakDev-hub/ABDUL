# Dashboard Environment Variables
# Copy this file to .env for local development
# Note: Only variables prefixed with VITE_ are exposed to the browser client

# API Configuration
# Backend API Gateway URL - must be accessible from the browser
# For local development:
VITE_API_GATEWAY_URL=http://localhost:5000

# Application Configuration (optional)
VITE_APP_TITLE=ABDUL - Hackathon Dashboard
VITE_APP_VERSION=1.0.0

# IMPORTANT: Production Configuration
# When building for production (vite build), update VITE_API_GATEWAY_URL to your backend URL
# Examples:
# VITE_API_GATEWAY_URL=https://api.yourdomain.com
# VITE_API_GATEWAY_URL=http://your-server-ip:5000
#
# For Docker deployments, set these values in GitHub Secrets as DASHBOARD_ENV:
# VITE_API_GATEWAY_URL=https://your-production-backend-url
# VITE_APP_TITLE=ABDUL - Hackathon Dashboard
# VITE_APP_VERSION=1.0.0