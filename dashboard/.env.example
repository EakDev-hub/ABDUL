# Environment variables for Dashboard
# Copy this file to .env for local development

# Vite configuration
VITE_HOST=0.0.0.0
VITE_PORT=5173

# API configuration
# For local development, point to your local backend
# For production (Docker), this will be set via DASHBOARD_ENV secret
VITE_API_BASE_URL=http://localhost:5000

# Application environment
VITE_APP_ENV=development
NODE_ENV=development

# Production Configuration (for reference)
# These values should be set in GitHub Secrets as DASHBOARD_ENV:
# NODE_ENV=production
# VITE_API_BASE_URL=http://localhost:5000
# VITE_APP_ENV=production