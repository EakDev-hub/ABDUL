# Environment variables for Dashboard
# Copy this file to .env for local development

# Vite configuration
VITE_HOST=0.0.0.0
VITE_PORT=5173

# API configuration
# For local development, point to your local backend
VITE_API_BASE_URL=http://localhost:5000

# Application environment
VITE_APP_ENV=development
NODE_ENV=development

# IMPORTANT: Production Configuration
# In production, set VITE_API_BASE_URL to your actual backend URL
# Examples:
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_API_BASE_URL=http://your-server-ip:5000
#
# For Docker deployments, these values should be set in GitHub Secrets as DASHBOARD_ENV:
# NODE_ENV=production
# VITE_API_BASE_URL=https://your-production-backend-url
# VITE_APP_ENV=production