# Namek Frontend Environment Variables
# Copy this file to .env and fill in the actual values

# Node Environment
NODE_ENV=production

# Application Configuration
VITE_APP_TITLE=ABDUL - Hackathon Platform
VITE_APP_VERSION=1.0.0

# API Configuration
# Backend API Gateway URL - must be accessible from the browser
# For local development:
VITE_API_GATEWAY_URL=http://localhost:5000
# For production (with nginx reverse proxy):
# API_GATEWAY_URL=/api

# Server Configuration
DOCKER_PORT=3000

# Feature Flags (optional)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG_MODE=false

# External Services (if needed)
# VITE_SENTRY_DSN=your_sentry_dsn_here
# VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Custom Application Settings
# Add any other environment variables your frontend needs here