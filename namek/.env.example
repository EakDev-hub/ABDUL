# Environment Configuration Template
# คัดลอกไฟล์นี้เป็น .env สำหรับ local development

# Build Stage (local, dev, staging, prod)
BUILD_STAGE=local

# API Gateway URL
# สำหรับ local development ให้ใส่ URL ของ backend ที่รันอยู่
# ตัวอย่าง: http://localhost:5000 หรือ http://localhost:8080
API_GATEWAY_URL=http://localhost:5000

# Docker Port (optional - ใช้เมื่อรัน Docker)
DOCKER_PORT=3000