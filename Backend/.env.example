# Backend Environment Variables
# Copy this file to .env and fill in the actual values

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# API Configuration
AllowedHosts=*

# External API Keys (if needed)
# OPENROUTER_API_KEY=your_api_key_here
# TEAM_API_URL=https://api.example.com
# TEAM_API_KEY=your_api_key_here

# Database Configuration (if applicable)
# DATABASE_URL=Server=db;Database=abdul;User Id=sa;Password=YourPassword;
# CONNECTION_STRING=your_connection_string_here

# CORS Configuration
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Custom Application Settings
# Add any other environment variables your backend needs here
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=hackathon
DB_USER=myuser
DB_PASSWORD=mypassword
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxx
